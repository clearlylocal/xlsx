{
  "name": "xlsx",
  "version": "0.20.0",
  "description": "SheetJS Spreadsheet data parser and writer",
  "keywords": [
    "csv",
    "dbf",
    "dif",
    "excel",
    "ods",
    "office",
    "spreadsheet",
    "sylk",
    "xls",
    "xlsb",
    "xlsm",
    "xlsx"
  ],
  "homepage": "https://sheetjs.com/",
  "bugs": {
    "url": "https://git.sheetjs.com/SheetJS/sheetjs/issues"
  },
  "license": "Apache-2.0",
  "author": "sheetjs",
  "repository": {
    "type": "git",
    "url": "https://git.sheetjs.com/SheetJS/sheetjs"
  },
  "bin": {
    "xlsx": "./bin/xlsx.njs"
  },
  "sideEffects": false,
  "main": "xlsx.js",
  "module": "xlsx.mjs",
  "browser": {
    "buffer": false,
    "crypto": false,
    "stream": false,
    "process": false,
    "fs": false
  },
  "types": "types/index.d.ts",
  "unpkg": "dist/xlsx.full.min.js",
  "jsdelivr": "dist/xlsx.full.min.js",
  "exports": {
    ".": {
      "import": "./xlsx.mjs",
      "require": "./xlsx.js",
      "types": "./types/index.d.ts"
    },
    "./xlsx.mjs": {
      "import": "./xlsx.mjs",
      "types": "./types/index.d.ts"
    },
    "./xlsx.js": {
      "require": "./xlsx.js",
      "types": "./types/index.d.ts"
    },
    "./dist/xlsx.zahl": {
      "import": "./dist/xlsx.zahl.mjs",
      "require": "./dist/xlsx.zahl.js",
      "types": "./dist/zahl.d.ts"
    },
    "./dist/xlsx.zahl.mjs": {
      "import": "./dist/xlsx.zahl.mjs",
      "types": "./dist/zahl.d.ts"
    },
    "./dist/xlsx.zahl.js": {
      "require": "./dist/xlsx.zahl.js",
      "types": "./dist/zahl.d.ts"
    },
    "./dist/cpexcel": {
      "import": "./dist/cpexcel.full.mjs",
      "require": "./dist/cpexcel.js",
      "types": "./dist/cpexcel.d.ts"
    },
    "./dist/cpexcel.js": {
      "require": "./dist/cpexcel.js",
      "types": "./dist/cpexcel.d.ts"
    },
    "./dist/cpexcel.full": {
      "import": "./dist/cpexcel.full.mjs",
      "require": "./dist/cpexcel.js",
      "types": "./dist/cpexcel.d.ts"
    },
    "./dist/cpexcel.full.mjs": {
      "import": "./dist/cpexcel.full.mjs",
      "types": "./dist/cpexcel.d.ts"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:check": "node scripts/build.mjs --check",
    "test": "node --test test/*.test.mjs",
    "update": "node scripts/update.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@sheetjs/uglify-js": "~2.7.3",
    "@types/node": "^8.5.9",
    "acorn": "7.4.1",
    "adler-32": "~1.3.1",
    "alex": "8.1.1",
    "blanket": "~1.2.3",
    "cfb": "~1.2.2",
    "codepage": "~1.15.0",
    "commander": "~2.17.1",
    "crc-32": "~1.2.2",
    "dtslint": "^0.1.2",
    "eslint": "7.23.0",
    "eslint-plugin-html": "^6.1.2",
    "eslint-plugin-json": "^2.1.2",
    "exit-on-epipe": "~1.0.1",
    "fflate": "^0.7.1",
    "jsdom": "~11.1.0",
    "markdown-spellcheck": "^1.3.1",
    "mocha": "~2.5.3",
    "sinon": "^1.17.7",
    "ssf": "~0.11.2",
    "typescript": "2.2.0",
    "wmf": "~1.0.1",
    "word": "~0.3.0"
  },
  "config": {
    "blanket": {
      "pattern": "xlsx.js"
    }
  },
  "engines": {
    "node": ">=0.8"
  },
  "alex": {
    "allow": [
      "chinese",
      "special",
      "simple",
      "just",
      "crash",
      "wtf",
      "holes"
    ]
  }
}
